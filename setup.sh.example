#!/bin/bash
#
# One-shot provisioning for a fresh Ubuntu VPS: swap, Docker, the deployment
# files, generated secrets, HTTPS. Copy to `setup.sh`, fill in the config block,
# then run it as root on a box with nothing on it yet.
#
#   scp setup.sh root@203.0.113.10:/root/
#   ssh root@203.0.113.10 'bash /root/setup.sh'
#
# This is DEPLOY.md's "Option B" walkthrough with the typing removed. Read that
# first if you want to know what each step is for; nothing here does anything
# the manual instructions don't.
#
# **DNS comes first and this script will not do it for you.** Create the A
# record, wait for it to resolve, then run this — Let's Encrypt validates over
# HTTP against the name, so Caddy cannot get a certificate for a hostname that
# doesn't point here yet. The preflight below refuses to continue rather than
# letting you discover that in the ACME logs.

set -euo pipefail

# ============ CONFIG — fill these in ============
DOMAIN="scibrarian.example.com"        # A record must already point at this box
ACME_EMAIL="you@example.com"           # Let's Encrypt expiry notices
BASIC_AUTH_USER="admin"                # edge login for the whole site
# Pin a release instead of tracking `latest`. Leave empty to track latest.
SCIBRARIAN_TAG=""
# ==================================================

INSTALL_DIR="/root/scibrarian"
CREDS_FILE="/root/credentials.txt"

# --- Preflight ------------------------------------------------------------
# Everything below writes to /root, installs packages and binds 80/443.
[ "$(id -u)" -eq 0 ] || { echo "Run as root."; exit 1; }

case "$DOMAIN" in
  scibrarian.example.com|"")
    echo "Set DOMAIN in the config block first."; exit 1 ;;
esac
case "$ACME_EMAIL" in
  you@example.com|"")
    echo "Set ACME_EMAIL in the config block first."; exit 1 ;;
esac

apt-get update
apt-get install -y ca-certificates curl dnsutils

# The check that saves the confusing failure: a name that resolves somewhere
# else produces a Caddy that retries ACME forever and a site that never comes
# up, with nothing in the output pointing at DNS.
#
# -4 first. On a dual-stack host an unforced request answers with the box's
# IPv6 address, which can never equal the IPv4 answer from `dig A` below — so a
# correctly pointed A record is refused as a mismatch and nothing after this
# point runs.
#
# Unforced second, rather than letting the forced one fail. An IPv6-only box has
# no IPv4 address to report, so `-4` on its own aborts here under `set -e` with
# curl's terse stderr and not a word about DNS — a preflight whose whole job is
# to name the subject, failing without naming anything. Which family answers
# also decides which record has to point here.
PUBLIC_IP="$(curl -4 -fsS https://ifconfig.me || curl -fsS https://ifconfig.me || true)"
[ -n "$PUBLIC_IP" ] || {
  echo "Couldn't reach ifconfig.me to find this box's public address."
  echo "Check outbound networking and re-run."
  exit 1
}
case "$PUBLIC_IP" in
  *:*) RECORD="AAAA" ;;
  *)   RECORD="A" ;;
esac
RESOLVED="$(dig +short "$DOMAIN" "$RECORD" | tail -n1)"
if [ -z "$RESOLVED" ]; then
  echo "$DOMAIN has no $RECORD record yet. Create it:"
  echo "    $RECORD    $DOMAIN    ->    $PUBLIC_IP"
  echo "then wait for it (dig +short $DOMAIN $RECORD) and re-run."
  exit 1
fi
if [ "$RESOLVED" != "$PUBLIC_IP" ]; then
  echo "$DOMAIN resolves to $RESOLVED, but this box is $PUBLIC_IP."
  echo "Point the $RECORD record here (or wait for the old one to expire) and re-run."
  exit 1
fi

# --- Swap (a 1 GB box has no headroom without it) -------------------------
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
  echo 'vm.swappiness=10' >> /etc/sysctl.conf
  sysctl -p
fi

# --- Docker ----------------------------------------------------------------
if ! command -v docker >/dev/null 2>&1; then
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
    https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    > /etc/apt/sources.list.d/docker.list
  apt-get update
  apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi

# --- Deployment files ------------------------------------------------------
mkdir -p "$INSTALL_DIR" && cd "$INSTALL_DIR"

# Empty on a first install. A re-provision finds the previous run's Caddyfile
# here, and the Caddy already running is still serving from it — so the launch
# step below can tell whether a bounce would change anything.
CADDY_CONFIG_WAS=""
if [ -f Caddyfile ]; then
  CADDY_CONFIG_WAS="$(md5sum < Caddyfile)"
fi

base=https://raw.githubusercontent.com/scibrarian/scibrarian/master
curl -fsSLO "$base/docker-compose.prod.yml"
curl -fsSL "$base/Caddyfile.example" -o Caddyfile

# --- Secrets ---------------------------------------------------------------
# Generated rather than chosen: these are typed once into a browser and then
# lived with, so there is no reason for them to be memorable.
ADMIN_TOKEN="$(openssl rand -hex 32)"
BASIC_AUTH_PASS="$(openssl rand -hex 12)"

{
  echo "ADMIN_TOKEN=${ADMIN_TOKEN}"
  echo "DOMAIN=${DOMAIN}"
  echo "ACME_EMAIL=${ACME_EMAIL}"
  [ -n "$SCIBRARIAN_TAG" ] && echo "SCIBRARIAN_TAG=${SCIBRARIAN_TAG}"
} > .env
chmod 600 .env

# The hash goes in the Caddyfile, never .env — docker-compose mangles the `$`
# characters in a bcrypt hash.
HASH="$(docker run --rm caddy:2 caddy hash-password --plaintext "$BASIC_AUTH_PASS")"
sed -i "s|admin REPLACE_WITH_YOUR_BCRYPT_HASH|${BASIC_AUTH_USER} ${HASH}|" Caddyfile

cat > "$CREDS_FILE" <<EOF
URL:              https://${DOMAIN}
Basic auth user:  ${BASIC_AUTH_USER}
Basic auth pass:  ${BASIC_AUTH_PASS}
ADMIN_TOKEN:      ${ADMIN_TOKEN}

The basic-auth prompt gates the site. ADMIN_TOKEN unlocks writes inside it —
padlock in the header.
EOF
chmod 600 "$CREDS_FILE"

# --- Launch ----------------------------------------------------------------
docker compose -f docker-compose.prod.yml up -d

# Caddy's config is a bind-mounted file, and compose diffs a service's
# *definition*, not the contents of what it mounts — so a second run fetches a
# fresh Caddyfile, seds a new hash into it, and does not recreate the container
# reading it. Caddy parses that file once at startup and watches nothing, so the
# previous run's password stays in force while the credentials file confidently
# reports the new one.
#
# Guarded, because the bounce is destructive before there is a certificate:
# `up -d` returns as soon as the container starts, Caddy is already mid-HTTP-01
# for the name, and a SIGTERM there abandons that order. Let's Encrypt records a
# failed validation, and five per hostname per hour is the whole budget. Once
# the certificate is in the caddy-data volume the restart issues nothing and
# costs a second.
#
# Guarded on the certificate itself, and it used to be guarded on "was there a
# Caddyfile" — the same question asked of the wrong thing. A first install that
# got as far as writing one and then failed for any other reason (the app never
# came up, and the wait below exits 1) leaves a Caddyfile behind with no
# certificate beside it. A fresh bcrypt hash is sed'd in on every run, so the
# contents always differ too: the re-run an operator makes after fixing the
# cause bounced a Caddy that was mid-validation. That is the case this guard
# exists for, reached by the path people actually take to it.
#
# Unaskable counts as no. If the exec fails, the config stays stale and the
# credentials file names a password that isn't in force — annoying, and fixed
# by another run. Guessing the other way spends validations that can't be got
# back for an hour.
have_cert() {
  docker compose -f docker-compose.prod.yml exec -T caddy \
    sh -c "ls /data/caddy/certificates/*/${DOMAIN}/${DOMAIN}.crt" >/dev/null 2>&1
}
if [ "$CADDY_CONFIG_WAS" != "$(md5sum < Caddyfile)" ] && have_cert; then
  docker compose -f docker-compose.prod.yml restart caddy
fi

# The first certificate takes a few seconds, so report the app rather than the
# edge: a 200 here means the container is healthy even if ACME is still going.
echo -n "waiting for the app"
UP=0
for _ in $(seq 1 60); do
  if docker compose -f docker-compose.prod.yml exec -T scibrarian \
      node -e "fetch('http://127.0.0.1:3001/api/auth').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" 2>/dev/null; then
    UP=1; echo " — up"; break
  fi
  echo -n "."; sleep 2
done
# Two minutes of dots and then "Done." was a box that never started being
# reported as a finished install. Both Pro scripts guard this the same way.
[ "$UP" -eq 1 ] || { echo; echo "App did not come up. docker compose -f docker-compose.prod.yml logs scibrarian"; exit 1; }

echo
echo "Done. https://${DOMAIN}"
echo "Credentials: ${CREDS_FILE}"
echo
echo "If the site doesn't answer, watch the certificate being issued:"
echo "  docker compose -f docker-compose.prod.yml -p ${INSTALL_DIR##*/} logs -f caddy"
